rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public read collections for institutional information & circulars
    match /circulars/{circularId} {
      allow read: if true;
      allow write: if true;
    }

    match /schools/{schoolId} {
      allow read: if true;
      allow write: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /placements/{placementId} {
      allow read: if true;
      allow write: if true;
    }

    match /research_projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    match /documents/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if true;
    }

    match /quick_links/{linkId} {
      allow read: if true;
      allow write: if true;
    }

    match /dynamic_pages/{slug} {
      allow read: if true;
      allow write: if true;
    }

    match /ai_knowledge_sources/{sourceId} {
      allow read: if true;
      allow write: if true;
    }

    match /system_config/{configDoc} {
      allow read: if true;
      allow write: if true;
    }

    // User accounts & RBAC Directory
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Communications & Notification Broadcasts
    match /dispatched_messages/{msgId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Immutable Security Audit Logs (Write-once, never update or delete)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Student Grievances
    match /grievances/{ticketId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Chat History & AI Interactions
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Catch-all fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
