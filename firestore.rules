rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read on circulars, authenticated create/update
    match /circulars/{circularId} {
      allow read: if true;
      allow write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // AI Chat history
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Feedback & Grievances
    match /grievances/{item} {
      allow read, write: if true;
    }

    // General fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
