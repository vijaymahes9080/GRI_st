{
  "entities": {
    "users": {
      "title": "Users",
      "description": "Registered students, faculty, staff and administrators with role-based attributes",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "rollNumber": { "type": "string" },
        "phone": { "type": "string" },
        "status": { "type": "string" },
        "attendance": { "type": "number" },
        "registeredAt": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "circulars": {
      "title": "Circulars & Notices",
      "description": "Official institutional notices, advisories, and administrative circulars",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "publishDate": { "type": "string" },
        "isImportant": { "type": "boolean" },
        "department": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "targetAudience": { "type": "string" }
      },
      "required": ["title", "category", "publishDate"]
    },
    "events": {
      "title": "Events",
      "description": "Academic seminars, cultural festivals, sports meets, and conferences",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string" },
        "time": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "registrationLink": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["title", "date", "location"]
    },
    "grievances": {
      "title": "Student Grievances",
      "description": "Grievance ticketing system for academics, hostels, amenities, and transport",
      "type": "object",
      "properties": {
        "ticketId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "response": { "type": "string" }
      },
      "required": ["ticketId", "studentId", "title", "status"]
    },
    "audit_logs": {
      "title": "Security Audit Logs",
      "description": "Immutable security and administrative action audit trail",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actorRole": { "type": "string" },
        "targetId": { "type": "string" },
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "actorRole", "timestamp"]
    },
    "dispatched_messages": {
      "title": "Dispatched Messages",
      "description": "SMS and Email communications dispatched across departments",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "target": { "type": "string" },
        "channel": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string" },
        "recipientCount": { "type": "number" }
      },
      "required": ["title", "target", "channel", "timestamp"]
    }
  },
  "firestoreRules": "rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    match /{document=**} {\n      allow read, write: if true;\n    }\n  }\n}"
}
