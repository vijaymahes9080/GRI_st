    {
      "name": "GRI Admin Portal Vercel",
      "type": "http",
      "url": "https://admin.ruraluniv.ac.in",
      "interval": 120,
      "accepted_statuscodes": ["200-299"]
    },
    {
      "name": "Official GRI Source Sync (ruraluniv.ac.in)",
      "type": "http",
      "url": "https://ruraluniv.ac.in",
      "interval": 300,
      "accepted_statuscodes": ["200-299"]
    }
  ]
}
