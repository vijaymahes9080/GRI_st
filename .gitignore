**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
android/app/google-services.json

# Flutter symbol maps
*.symbols

# Avoid committing generated code
*.g.dart
*.gen.dart


