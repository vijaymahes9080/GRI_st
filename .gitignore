# =============================================================================
# GRI Flutter Application — .gitignore
# Covers: Flutter/Dart, Python, Node.js, PostgreSQL, Docker, IDE, OS, Secrets
# =============================================================================


# =============================================================================
# SECRETS & ENVIRONMENT VARIABLES — Never commit these
# =============================================================================
.env
.env.*
*.env
.env.local
.env.production
.env.development
secrets/
secrets.json
service_account.json
google-services.json
GoogleService-Info.plist
keystore/
*.jks
*.keystore
*.p12
*.pem
*.key
*.crt
*.pfx


